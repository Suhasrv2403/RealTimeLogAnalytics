# Canonical pipeline configuration.
#
# Every value here was previously hardcoded independently across multiple
# scripts and Dockerfiles (see docs/DETAILS.md for the audit history).
# Every script in src/ and scripts/ loads this file via
# src/common/env_config.py and falls back to the same values shown here as
# its own hardcoded defaults, so nothing breaks if this file is missing or
# a value is deleted — it's a single place to override, not a requirement.
#
# Real secrets should NOT go in a file tracked by git; the credentials
# below are the well-known MinIO/Kafka local-dev defaults, not real
# secrets. For anything sensitive, use a separate untracked
# `configs/pipeline.local.env` and source it after this file.

# --- Kafka -------------------------------------------------------------
# In-network broker address, used by services running inside the
# docker-compose network (scripts/kafka/create_topic.py, src/spark/log_consumer.py).
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka:9092
KAFKA_HOST=kafka
KAFKA_PORT=9092

# Host-exposed broker address, used when running from the developer's
# machine (scripts/kafka/log_generator.py).
KAFKA_BOOTSTRAP_SERVERS_HOST=localhost:29092

# Topic that all logs are produced to / consumed from.
KAFKA_LOGS_TOPIC=logs
KAFKA_LOGS_TOPIC_PARTITIONS=1
KAFKA_LOGS_TOPIC_REPLICATION_FACTOR=1

# --- Log generator (scripts/kafka/log_generator.py) ----------------------
# Reproducibility seed for the synthetic log generator's RNG.
LOG_GEN_SEED=42
LOG_GEN_USER_ID_MIN=1
LOG_GEN_USER_ID_MAX=100
LOG_GEN_INTERVAL_SECONDS=1
LOG_GEN_STATUS_VALUES=put,get,auth,rmi

# --- MinIO / S3A (src/spark/log_consumer.py, docker/spark-app/run.sh) ---
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=logs
MINIO_PARQUET_PATH=s3a://logs/parquet_logs/

# --- Spark Structured Streaming (src/spark/log_consumer.py) -------------
SPARK_TRIGGER_INTERVAL_SECONDS=10
SPARK_CHECKPOINT_LOCATION=/tmp/checkpoint_logs

# --- Kafka Connect -> Elasticsearch sink (scripts/deploy_connectors.sh) --
KAFKA_CONNECT_URL=http://localhost:18083
ELASTICSEARCH_URL=http://elasticsearch:9200
